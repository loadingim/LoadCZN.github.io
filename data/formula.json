  "steps": [
    { "id": "atkN", "order": 1, "name": "기본 공격력 N", "calc": "전투원 기본 공격력 + 파트너 공격력 + 기억의 조각 깡공", "kind": "가산", "status": "교차 검증", "src": ["dc-atk", "dc-atk-group2", "prydwen"], "note": "Prydwen은 조각 공격력%가 전투원 기본 공격력에만 곱해진다고 적었고, 디시 2026-06 글은 N 전체에 곱해진다고 적었다. 계산기는 최신 실험인 디시 글을 따른다." },
    { "id": "atkA", "order": 2, "name": "A그룹 공격력% (장비·파트너)", "calc": "N × (1 + Σ) — 그룹 안은 합연산", "kind": "곱(그룹 내 합)", "status": "검증 완료", "src": ["dc-atk-group", "dc-atk-group2", "prydwen", "user-ross"], "note": "로스바이세 실측: 전투원 + 파트너 공격력 634 × (1 + 시그 패시브 16% + 아군 무기 효과 8% + 혼돈의 지적 18% + 데이터 변이 14%) + 무기 90 = 1079로 스테이터스 값과 일치 (모두 한 그룹 합연산).", "examples": ["혼돈의 지적 +18%", "혼세의 촉수 +8%", "노래하는 검 +15%", "파트너 패시브 공격력 증가", "데이터 변이 공격력% (스테이터스에 바로 반영)", "아군 장비의 아군 공격력 증가"] },
    { "id": "atkB", "order": 3, "name": "B그룹 공격력% (기억의 조각)", "calc": "× (1 + Σ) — A그룹과 서로 곱", "kind": "곱(그룹 내 합)", "status": "교차 검증", "src": ["dc-atk", "dc-atk-group", "prydwen"], "examples": ["검은 날개 +12%", "조각 주옵션·부옵션 공격력%"] },
    { "id": "atkC", "order": 4, "name": "무기 기본 공격력", "calc": "+ C (A·B 영향을 받지 않음)", "kind": "별도 가산", "status": "교차 검증", "src": ["dc-atk-group2", "prydwen-equip"], "examples": ["5단계 강화 기준 희귀 74 · 전설 82 · 신화 90"] },
    { "id": "atkD", "order": 5, "name": "심록 장신구 공격력", "calc": "시즌 4부터 A그룹과 합연산 (이전에는 × (1 + D) 최종 곱)", "kind": "A그룹 합(시즌 4~)", "status": "교차 검증", "src": ["czn-s4", "vortex-s4", "dc-atk-group2"], "note": "공식 개발자 노트(2026-07-21 공지, 07-29 적용): 숲의 클로버를 포함한 일부 장비의 공격력%가 의도와 달리 곱연산으로 적용되던 것을 다른 공격력%(혼돈의 지적·혼세의 촉수 등)와 합연산으로 바꿈. 조정 대상에 심록의 낮·밤·굴레, 고동치는 알도 함께 올라 있음. 2026-06 디시 실측의 '최종 곱'은 그 이전 동작.", "examples": ["심록의 굴레 +12%", "심록의 밤 +12% (짝수 턴)", "심록의 낮 +8% (홀수 턴)"] },
    { "id": "atkG", "order": 6, "name": "숲의 클로버", "calc": "시즌 4부터 A그룹과 합연산 (이전에는 × (1 + G) 최종 곱)", "kind": "A그룹 합(시즌 4~)", "status": "교차 검증", "src": ["czn-s4", "vortex-s4", "dc-atk-group2"], "note": "공식 개발자 노트(2026-07-21 공지, 07-29 적용): 숲의 클로버를 포함한 일부 장비의 공격력%가 의도와 달리 곱연산으로 적용되던 것을 다른 공격력%(혼돈의 지적·혼세의 촉수 등)와 합연산으로 바꿈. 조정 대상에 심록의 낮·밤·굴레, 고동치는 알도 함께 올라 있음. 2026-06 디시 실측의 '최종 곱'은 그 이전 동작. 전투 중 스테이터스 상세의 공격력에는 표시되지 않는다 (로스바이세 실측: 클로버를 얻어도 761 그대로).", "examples": ["숲의 클로버 1턴간 아군 공격력 +10% (전투 중 효과라 스테이터스 역산 뒤에 더함)"] },
    { "id": "atkX", "order": 7, "name": "그 밖의 전투 중 공격력 버프", "calc": "× (1 + X) 로 가정", "kind": "곱(별도, 가정)", "status": "확인 불가", "src": [], "examples": ["최후의 명령어 +3% × 최대 6중첩"] },
    { "id": "base", "order": 8, "name": "카드 기본 배율", "calc": "카드에 적힌 피해 %", "kind": "기준값", "status": "검증 완료", "src": ["arca-recv"] },
    { "id": "potMul", "order": 9, "name": "잠재력 카드 강화", "calc": "× (1 + (레벨 + 에고 발현 보너스) × 2%) — 기본·중립·고유 카드 강화", "kind": "곱", "status": "검증 완료", "src": ["prydwen", "arca-recv", "user-ross"], "note": "하루 앵커 슛 400% × 1.2 = 480% (아카라이브 사례의 기본 배율)와 일치한다. 에고 발현의 '잠재력 레벨 3 증가'(5성 5단계 +3, 4성 3·5단계 +6)도 같은 레벨에 더해진다 (로스바이세 10 + 3 = 13레벨 → × 1.26, 실측 일치)." },
    { "id": "potAdd", "order": 10, "name": "잠재력 가산 (기본 카드 숙련 등)", "calc": "(기본 배율 + n%p) 에 더한 뒤 잠재력 곱을 적용", "kind": "가산", "status": "추정", "src": ["prydwen"] },
    { "id": "bAdd", "order": 11, "name": "기본 피해량 가산 (검수 등 스택 × 배율)", "calc": "잠재력 곱 뒤 카드 기본 배율에 + (스택 × 배율 %p) — 피해량 증가 곱보다 먼저", "kind": "가산", "status": "검증 완료", "src": ["user-ross"], "note": "로스바이세 명멸검(강화): 600 × 1.26 + 검수 20 × 80 = 2356. 잠재력 곱 앞에 더하면 실측과 맞지 않는다.", "examples": ["로스바이세 검수 1장당 +80%"] },
    { "id": "inc", "order": 12, "name": "피해량 n% 증가", "calc": "기본 배율 × (1 + Σ) — 같은 그룹끼리 합연산", "kind": "곱(그룹 내 합)", "status": "검증 완료", "src": ["arca-recv", "arca-basic", "dc-formula", "user", "user-ross"], "note": "파티원이 주는 '아군의 피해량 n% 증가'(영광의 군림 4세트, 티페라 창조)도 같은 합에 들어간다 (로스바이세 실측).", "examples": ["흑요석 검 12% 증가", "불꽃의 가면 35% 증가", "에너지 충전 50% 증가", "분쇄 20% 증가"] },
    { "id": "add", "order": 13, "name": "피해량 +n%", "calc": "계수에 n%p를 그대로 더함 (타격마다)", "kind": "별도 가산", "status": "검증 완료", "src": ["arca-recv", "arca-basic", "dc-formula", "user"], "examples": ["비정형 큐브 +25%", "사기 1당 +20%", "앵커 슛 사용 수 +100%"] },
    { "id": "eadd", "order": 14, "name": "대상이 받는 피해량 +n%", "calc": "'+n%'와 같은 자리에 더함 (최종 피해량을 곱하기 전)", "kind": "별도 가산", "status": "검증 완료", "src": ["arca-recv", "user-ross"], "note": "적의 불굴은 중첩당 −20%p로 이 자리에 음수로 더해진다 (불굴 5중첩 −100%p, 3중첩 −60%p 실측 일치).", "examples": ["이야기 속 진실 +100%", "이온화", "불굴 중첩당 −20%"] },
    { "id": "emul", "order": 15, "name": "받는 피해 n% 증가 (취약)", "calc": "× (1 + n%) — 취약은 × 1.5", "kind": "곱(별도)", "status": "검증 완료", "src": ["arca-recv", "dc-formula"] },
    { "id": "weak", "order": 16, "name": "약점 공격", "calc": "× 1.25 (잠재력·파트너로 오를 수 있음)", "kind": "곱(별도)", "status": "검증 완료", "src": ["arca-recv", "dc-formula", "prydwen", "user-ross"], "note": "핸드 표시에는 들어가지 않고, 카드를 적 위에 올렸을 때 표시에 들어간다 (로스바이세 실측). Prydwen은 추가 공격처럼 직접 사용하지 않은 피해에는 약점 배율이 붙지 않는다고 적었다 (실측 미확인)." },
    { "id": "fin", "order": 17, "name": "최종 피해량 n% 증가", "calc": "× (1 + n%) — 최종 피해량끼리도 서로 곱하고, 핸드 표시에도 들어감", "kind": "곱(별도)", "status": "검증 완료", "src": ["user-ross"], "note": "로스바이세 명멸검: 검끝 25% · 가호 20% · 에고 2단계 20%가 1.25 × 1.2 × 1.2 = 1.8로 곱해져 핸드 표시 12723%와 일치 (합이었다면 1.65)." },
    { "id": "dr", "order": 18, "name": "적 피해 감소 · 약화", "calc": "× (1 − 감소율), 약화 × 0.75", "kind": "곱(별도)", "status": "추정", "src": ["prydwen"] },
    { "id": "crit", "order": 19, "name": "치명타", "calc": "× 치명피해% (화면 값은 기본 100% 포함). 기대값 = 1 + 치명확률 × (치명피해 − 100%)", "kind": "곱(별도)", "status": "교차 검증", "src": ["prydwen", "dc-crit"] },
    { "id": "round", "order": 20, "name": "계수 표시", "calc": "소수점 첫째 자리 올림", "kind": "반올림 규칙", "status": "검증 완료", "src": ["arca-recv", "user", "user-ross"], "note": "최종 피해량을 곱하기 전에 계수를 정수로 버리는 것으로 보인다: 10975.4 × 1.8 → 게임 19755 (버리지 않고 올리면 19756). 1건뿐이라 계산기에는 넣지 않았다." },
    { "id": "k", "order": 21, "name": "공격력 반영 상수", "calc": "계수 × 최종 공격력 × 0.35", "kind": "곱", "status": "추정", "src": ["prydwen", "user-ross"], "note": "피해가 계수 × 최종 공격력 × (1 + 속성 피해량)에 비례하는 것은 실측 3건으로 확인했다 (공격력 517 → 1079, 계수 151% → 277%에서 같은 비율). 0.35 × 적 방어 계수 = 0.133~0.136이며, 0.35와 방어 계수는 분리하지 못했다." },
    { "id": "el", "order": 22, "name": "속성 피해량", "calc": "× (1 + 속성 피해량)", "kind": "곱(별도)", "status": "교차 검증", "src": ["prydwen", "dc-extra"] },
    { "id": "mech", "order": 23, "name": "추가 피해량 · 지속 피해량", "calc": "추가 공격은 × (1 + 추가 피해량), 지속 피해는 × (1 + 지속 피해량)", "kind": "곱(별도)", "status": "교차 검증", "src": ["prydwen", "dc-extra"], "note": "추가 피해량은 '추가 공격' 문구가 있는 피해와 협공에만 붙는다. 지속 피해량은 Prydwen 자료만 있다." },
    { "id": "def", "order": 24, "name": "적 방어 계수", "calc": "× 적 방어 계수", "kind": "곱", "status": "추정", "src": ["prydwen", "user-ross"], "note": "0.35 상수가 맞다고 보면 로스바이세 실측 3건에서 0.381(151% × 공격력 517, 속성 0% → 104), 0.388(151% × 786, 속성 8.4% → 174), 0.389(277.15% × 1079, 속성 8.4% → 441)이 나왔다. 계산기 기본값은 0.389. 40353% × 926.33 → 48818 사례는 그때 공격력(데이터 변이 14% 중복 입력 의심)과 속성 피해량을 확인하지 못해 뺐다. 상수와 분리하지 못했고 적마다 다를 수 있다." },
    { "id": "defBased", "order": 25, "name": "방어 기반 피해", "calc": "공격력 대신 (공격력 × 0.3 + 방어력 × 2.1)", "kind": "기준값 교체", "status": "추정", "src": ["prydwen"] }
  ],
